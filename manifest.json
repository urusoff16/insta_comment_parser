         "32": "icons/logo_32.png",
         "48": "icons/logo_48.png",
         "128": "icons/logo_128.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "js/background.js"
   },
   "content_scripts": [ {
